# Production (Vercel): MUST point to your live API, including /api
# Example: https://lotus-api.onrender.com/api
# Without this, product images (/uploads/...) will NOT show on Vercel.
VITE_API_URL=

# Optional: override only the image host (defaults to origin of VITE_API_URL)
# Example: https://lotus-api.onrender.com
# VITE_ASSET_URL=
